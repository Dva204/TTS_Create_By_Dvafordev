<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DvaForDev.WhiteboardStudio</AssemblyName>
    <RootNamespace>TTS_Create_By_DvaForDev</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\DvaForDev.Shared.csproj"/>
    <Content Include="whiteboard_tools\**\*.py"
      Exclude="whiteboard_tools\**\__pycache__\**\*;whiteboard_tools\test_*.py"
      CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
